ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/pitch
CELERY_BROKER_URL=redis://localhost:6380/0
STORAGE_DIR=storage
AUTH_JWT_SECRET=change-me-in-production
AUTH_JWT_EXP_MINUTES=60
CORS_ALLOW_ORIGINS=http://localhost:3000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# OpenAI-compatible endpoint (LiteLLM, OpenAI cloud, or Ollama at http://host:11434/v1)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://litellm.arbisoft.com/v1
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=pitch-creator
LANGSMITH_AGENT_ENVIRONMENT=local
SEED_USER_EMAIL=demo@arbisoft.com
SEED_USER_PASSWORD=pitch-demo-1
SEED_USER_NAME=Demo User
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
RETRIEVAL_VECTOR_K=40
RETRIEVAL_KEYWORD_K=40
RETRIEVAL_FUSED_POOL=40
RETRIEVAL_MAX_CHUNKS_PER_STUDY=3
RETRIEVAL_STUDY_LIMIT=15
RETRIEVAL_RRF_K=60
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MAX_LENGTH=1024
RERANK_QUERY_CHARS=1500
RERANK_MIN_SCORE=-5.0
# Structure ingest LLM: groq | openai | local
STRUCTURE_LLM_PROVIDER=openai
STRUCTURE_LLM_MODEL=groq/openai/gpt-oss-120b
# Thinking control for Ollama/Qwen. Empty omits the field. none disables.
STRUCTURE_LLM_REASONING_EFFORT=
# Completion cap for structure calls. 0 omits the field.
STRUCTURE_LLM_MAX_TOKENS=16384
# Retries after the first structure JSON call. Waits base, then double each time.
STRUCTURE_LLM_RETRY_LIMIT=4
STRUCTURE_LLM_RETRY_BASE_SECONDS=1
STRUCTURE_MODEL_REPO=Qwen/Qwen2.5-7B-Instruct-GGUF
STRUCTURE_MODEL_FILE=qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf
STRUCTURE_MODEL_THREADS=4
STRUCTURE_BATCH_SLIDES=2
